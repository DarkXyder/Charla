   "grammar": {
    "title": "un / una, el / la",
    "body": "Every Spanish noun is masculine or feminine. Most words ending in -o are masculine and most ending in -a are feminine. \"A\" is un (masculine) or una (feminine); \"the\" is el or la. Learn each new word with its article.",
    "examples": [
     {
      "es": "un café / el café",
      "en": "a coffee / the coffee"
     },
     {
      "es": "una limonada / la limonada",
      "en": "a lemonade / the lemonade"
     },
     {
      "es": "la cuenta",
      "en": "the check"
     }
    ]
   },
