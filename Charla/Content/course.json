    {
     "es": "Me llamo Ana.",
     "en": "My name is Ana.",
     "note": "Literally \"I call myself Ana\".",
     "id": "saludos.8"
    },
    {
     "es": "¿Cómo te llamas?",
     "en": "What's your name?",
     "id": "saludos.9"
    },
    {
     "es": "Mucho gusto.",
     "en": "Nice to meet you.",
     "id": "saludos.10"
    },
    {
     "es": "Adiós",
     "en": "Goodbye",
     "id": "saludos.11"
    },
    {
     "es": "Hasta luego.",
     "en": "See you later.",
     "id": "saludos.12"
    }
   ],
   "grammar": {
    "title": "Tú or usted?",
    "body": "Spanish has two ways to say \"you\". Use tú with friends, family and people your age. Use usted to be polite with strangers, older people or at work. The verb changes too: ¿Cómo estás? (tú) becomes ¿Cómo está usted? When in doubt, start with usted; people will tell you to use tú.",
    "examples": [
     {
      "es": "¿Cómo estás?",
      "en": "How are you? (friendly)"
     },
     {
      "es": "¿Cómo está usted?",
      "en": "How are you? (polite)"
     },
     {
      "es": "¿Cómo se llama usted?",
      "en": "What's your name? (polite)"
     }
    ]
   },
