   "grammar": {
    "title": "Age uses tener",
    "body": "In Spanish you don't \"are\" an age, you \"have\" it. Use tener (to have): tengo (I have), tienes (you have), tiene (he/she has, or usted). Add años (years) after the number.",
    "examples": [
     {
      "es": "Tengo treinta años.",
      "en": "I'm thirty."
     },
     {
      "es": "¿Cuántos años tiene tu hermano?",
      "en": "How old is your brother?"
     },
     {
      "es": "Mi hija tiene cinco años.",
      "en": "My daughter is five."
     }
    ]
   },
