    },
    {
     "es": "¿Cómo estás?",
     "en": "How are you?",
     "note": "Informal: friends, people your age.",
     "id": "saludos.5"
    },
    {
     "es": "Bien, gracias.",
     "en": "Fine, thanks.",
     "id": "saludos.6"
    },
    {
     "es": "¿Y tú?",
     "en": "And you?",
     "id": "saludos.7"
